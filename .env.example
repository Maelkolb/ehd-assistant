# ── Models ────────────────────────────────────────────────────────────────
# Claude (Sonnet 5.5 and Opus 5.5 are offered when a key is set)
ANTHROPIC_API_KEY=
# EFFORT=medium                      # low | medium | high | xhigh | max
# ANTHROPIC_MODELS=claude-sonnet-5-5,claude-opus-5-5   # restrict the offered models
# ANTHROPIC_FALLBACKS=1              # let the API re-run a declined request on another Claude model
# UTILITY_MODEL=claude-haiku-4-5     # follow-up suggestions

# A locally hosted model behind an OpenAI-compatible endpoint
# (vLLM, Ollama, llama.cpp server, TGI, LM Studio). Needs tool calling.
# LOCAL_LLM_BASE_URL=http://localhost:8000/v1
# LOCAL_LLM_MODEL=qwen3.8-27b
# LOCAL_LLM_LABEL=Qwen 3.8 (lokal)
# LOCAL_LLM_API_KEY=
# LOCAL_LLM_CONTEXT_TOKENS=64000     # the server's context window
# LOCAL_LLM_EFFORT=                  # sent as reasoning_effort when set
# LOCAL_LLM_TEMPERATURE=
# LOCAL_LLM_EXTRA_BODY=              # JSON merged into every request, e.g. {"chat_template_kwargs": {"enable_thinking": false}}

# DEFAULT_MODEL=claude-sonnet-5-5    # default: the first configured model

# ── Corpus ────────────────────────────────────────────────────────────────
# DATA_DIR=data
# CORPUS_REF=main                    # branch, tag or commit of telota/edition-humboldt-digital

# ── Agent ─────────────────────────────────────────────────────────────────
# MAX_ROUNDS=14                      # tool rounds per answer
# MAX_OUTPUT_TOKENS=32000
# WIKIPEDIA=1                        # offer the optional Wikipedia context switch
# SUGGESTIONS=1                      # follow-up questions

# ── Python sandbox ────────────────────────────────────────────────────────
# SANDBOX_MODE=subprocess            # subprocess | http | off   (docker compose sets http)
# SANDBOX_URL=http://sandbox:8001
# SANDBOX_TOKEN=change-me
# SANDBOX_TIMEOUT_SECONDS=40

# ── Public deployment ─────────────────────────────────────────────────────
# RATE_LIMIT_PER_HOUR=15             # requests per client and hour
# RATE_LIMIT_PREMIUM_PER_HOUR=3      # Opus per client and hour; beyond it Sonnet answers
# DAILY_REQUEST_BUDGET=500           # all clients together
# MAX_CONCURRENT_CHATS=8
# PROXY_HOPS=1                       # trusted reverse proxies in front (0 = none)
# FRAME_ANCESTORS='self' https://edition-humboldt.de   # who may embed Alex in an iframe
# CORS_ORIGINS=                      # only if the client is served from another origin
# LOG_QUERIES=0                      # 1 writes users' questions to the log
# FEEDBACK_LOG=                      # path of a JSON-lines file; enables thumbs up/down
# MAP_TILE_URL=https://{s}.tile.openstreetmap.de/{z}/{x}/{y}.png
# MAP_ATTRIBUTION=© OpenStreetMap-Mitwirkende
# LINK_IMPRINT=https://edition-humboldt.de/impressum.xql
# LINK_PRIVACY=https://edition-humboldt.de/impressum.xql
