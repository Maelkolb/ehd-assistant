# === LLM (Claude is the default backend) ===
ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-haiku-4-5         # default Claude model (dropdown offers sonnet/opus)
EFFORT=medium                        # Sonnet/Opus thinking budget; unset = high.
                                     # medium: -22% cost, quality parity (scripts/eval_cost.py A/B 2026-07)

# Fallbacks, only used when ANTHROPIC_API_KEY is unset:
# OPENAI_API_KEY=sk-...
# GOOGLE_CLOUD_PROJECT=my-project    # enables Gemini via Vertex AI
# GEMINI_MODEL=gemini-3.5-flash      # REQUIRED for Gemini — no hardcoded default

# === API ===
# API_PORT=8000
# CORS_ORIGINS=https://edition-humboldt.de,http://localhost:3000

# === Rate limiting (per Cloud Run instance — service must run at
#     --max-instances=1, or these limits are effectively multiplied) ===
# RATE_LIMIT_PER_HOUR=10       # requests per IP per hour, any model
# RATE_LIMIT_OPUS_PER_HOUR=2   # Opus specifically; beyond this an IP's Opus
                                # requests transparently fall back to Sonnet
# DAILY_REQUEST_BUDGET=500     # global daily cap, shared by all visitors
